# ==============================================================================
# AlgoBrainDoctor — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# All VITE_* variables are bundled into the client build by Vite.
# Do not put secrets in VITE_* variables that should remain server-side.

# ------------------------------------------------------------------------------
# AI / OpenAI
# ------------------------------------------------------------------------------
# Recommended: set VITE_OPENAI_PROXY_URL to a server-side route you control
# (e.g. /api/ai) that forwards requests to OpenAI and adds the real API key.
# This prevents the API key from being embedded in the browser bundle.
VITE_OPENAI_PROXY_URL=

# Direct API key (only suitable for internal/trusted deployments).
# ⚠️  VITE_* variables are embedded in the browser bundle and visible to users.
#     Use VITE_OPENAI_PROXY_URL for public deployments instead.
VITE_OPENAI_API_KEY=

# OpenAI model to use for prompt optimization (default: gpt-4o-mini).
VITE_OPENAI_MODEL=gpt-4o-mini

# OpenAI API base URL. Override to use a compatible proxy or Azure OpenAI.
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Maximum tokens for each AI response.
VITE_OPENAI_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Semantic version injected at build time (usually set by CI from git tag).
VITE_APP_VERSION=0.0.0

# Log verbosity: debug | info | warn | error
VITE_LOG_LEVEL=info

# Set to "true" to disable rate limiting (development only).
VITE_DISABLE_RATE_LIMIT=false

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking (optional).
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# Web3
# ------------------------------------------------------------------------------
# WalletConnect project ID (required for WalletConnect v2 support).
# Obtain from https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------------------
# Database / Firebase (optional — for future dedicated backend)
# ------------------------------------------------------------------------------
# Firebase project configuration JSON (single-line, URL-encoded or base64).
VITE_FIREBASE_CONFIG=

# ------------------------------------------------------------------------------
# Docker / Infrastructure (not bundled by Vite — server-side only)
# ------------------------------------------------------------------------------
# Port the web container listens on (default 8080).
WEB_PORT=8080

# Redis password for the optional cache/rate-limit layer.
REDIS_PASSWORD=changeme

# Redis port.
REDIS_PORT=6379
